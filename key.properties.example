# Copy to key.properties (never commit it) and fill in your own values.
# Create the keystore yourself, for example:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storeFile=../upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
